<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Xpense restores from nuget.org and nothing else.

    `clear` drops any source inherited from the machine or user NuGet config. Without it, a private
    feed configured globally is consulted for every restore here, and when it is unreachable, which it
    is on any machine not on that network, every build reports NU1900 for a source this project never
    wanted. Pinning the sources in the repository also means a restore resolves the same packages
    wherever it runs rather than depending on whose machine it is.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
